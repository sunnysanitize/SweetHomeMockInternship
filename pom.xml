<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.eteks</groupId>
  <artifactId>sweet-home-3d-internship</artifactId>
  <version>5.4-internship</version>
  <name>Sweet Home 3D Internship</name>

  <properties>
    <project.build.sourceEncoding>ISO-8859-1</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
    <junit.version>5.10.0</junit.version>
  </properties>

  <!--
    Sweet Home 3D 5.4 predates Maven and bundles libraries that are no longer
    readily available from Maven Central. System-scoped dependencies are used
    deliberately so a clone contains all legacy application dependencies.
  -->
  <dependencies>
    <dependency>
      <groupId>legacy.sweethome3d</groupId>
      <artifactId>batik-svgpathparser</artifactId>
      <version>1.7</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/SweetHome3D/lib/batik-svgpathparser-1.7.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>legacy.sweethome3d</groupId>
      <artifactId>freehep-vectorgraphics-svg</artifactId>
      <version>2.1.1b</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/SweetHome3D/lib/freehep-vectorgraphics-svg-2.1.1b.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>legacy.sweethome3d</groupId>
      <artifactId>itext</artifactId>
      <version>2.1.7</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/SweetHome3D/lib/iText-2.1.7.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>legacy.sweethome3d</groupId>
      <artifactId>java3d-core</artifactId>
      <version>1.5.2</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/SweetHome3D/lib/j3dcore.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>legacy.sweethome3d</groupId>
      <artifactId>java3d-utils</artifactId>
      <version>1.5.2</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/SweetHome3D/lib/j3dutils.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>legacy.sweethome3d</groupId>
      <artifactId>jmf</artifactId>
      <version>2.1.1e</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/SweetHome3D/lib/jmf.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>legacy.sweethome3d</groupId>
      <artifactId>sunflow</artifactId>
      <version>0.07.3i</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/SweetHome3D/lib/sunflow-0.07.3i.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>legacy.sweethome3d</groupId>
      <artifactId>vecmath</artifactId>
      <version>1.5.2</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/SweetHome3D/lib/vecmath.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>legacy.sweethome3d</groupId>
      <artifactId>apple-java-extensions</artifactId>
      <version>1.4</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/SweetHome3D/libtest/AppleJavaExtensions.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>SweetHome3D/src</sourceDirectory>
    <testSourceDirectory>assignment-tests</testSourceDirectory>
    <resources>
      <resource>
        <directory>SweetHome3D/src</directory>
        <excludes>
          <exclude>**/*.java</exclude>
          <exclude>**/package.html</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <encoding>ISO-8859-1</encoding>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.1.2</version>
        <configuration>
          <argLine>-Djava.awt.headless=true</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <mainClass>com.eteks.sweethome3d.SweetHome3D</mainClass>
          <!-- Include the bundled system-scoped legacy libraries at launch. -->
          <classpathScope>compile</classpathScope>
          <!-- On macOS Java 8, use the JDK's real Apple APIs instead of the
               compile-time stubs in AppleJavaExtensions.jar. -->
          <forcedJvmPackages>
            <forcedJvmPackage>com.apple.</forcedJvmPackage>
          </forcedJvmPackages>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
